# Frontend configuration. Copy to .env.local for `next dev` / `next build`.
# NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time
# (rebuild the image after changing them); the others are read by the server at runtime.

# ── backend ────────────────────────────────────────────────────────────────
# Public backend URL used by the browser (docker compose: http://localhost:8080)
NEXT_PUBLIC_API_URL=http://localhost:8080
# Optional: backend URL for server-side requests (structured data, legal pages,
# landing pages) when the server reaches the backend on an internal address,
# e.g. http://backend:8080 in docker compose / Azure Container Apps.
# Defaults to NEXT_PUBLIC_API_URL.
API_URL_INTERNAL=
# Tenant slug of this website (the demo shop)
NEXT_PUBLIC_TENANT=the-barber-news

# ── SEO ────────────────────────────────────────────────────────────────────
# Public origin of the website WITHOUT trailing slash, e.g. https://www.thebarbernews.de
# Used for canonical URLs, hreflang alternates, Open Graph URLs, sitemap.xml,
# robots.txt and the schema.org data. Must be the production domain in prod.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── analytics & ads (all optional; default: none = no-op, nothing is loaded) ─────
# Scripts are only injected AFTER the visitor's consent for the category:
#   statistics → GA4, marketing → Google Ads + Meta Pixel. Keep the privacy policy
#   (src/content/legal/Privacy.tsx) in sync with what you enable here.
# Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA4_ID=
# Google Ads conversion tracking (booking_confirmed → conversion), e.g. AW-123456789 + label
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
# Meta (Facebook/Instagram) Pixel id (booking_submitted → Lead, booking_confirmed → Schedule)
NEXT_PUBLIC_META_PIXEL_ID=

# ── bot protection (optional) ─────────────────────────────────────────────────
# Cloudflare Turnstile site key. Set → booking, registration and "forgot password"
# show the widget and send its token (X-Captcha-Token); the backend must then run
# APP_CAPTCHA_PROVIDER=turnstile with the matching APP_CAPTCHA_SECRET. Empty → no widget
# (local dev, e2e). Also adds challenges.cloudflare.com to the Content-Security-Policy.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── demo strip ─────────────────────────────────────────────────────────────────
# Site-wide "DEMO" strip while the backend runs demo payments. Default (unset) = shown;
# false = hidden (production builds). The payment page keeps its own demo notice.
NEXT_PUBLIC_SHOW_DEMO_BANNER=
