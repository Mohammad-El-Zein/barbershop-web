# Frontend configuration. Copy to .env.local for `next dev` / `next build`.
# NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time
# (rebuild the image after changing them); the others are read by the server at runtime.

# ── backend ────────────────────────────────────────────────────────────────
# Public backend URL used by the browser (docker compose: http://localhost:8080)
NEXT_PUBLIC_API_URL=http://localhost:8080
# Optional: backend URL for server-side requests (structured data, legal pages,
# landing pages) when the server reaches the backend on an internal address,
# e.g. http://backend:8080 in docker compose / Azure Container Apps.
# Defaults to NEXT_PUBLIC_API_URL.
API_URL_INTERNAL=
# Tenant slug of this website (the demo shop)
NEXT_PUBLIC_TENANT=the-barber-news

# ── SEO ────────────────────────────────────────────────────────────────────
# Public origin of the website WITHOUT trailing slash, e.g. https://www.thebarbernews.de
# Used for canonical URLs, hreflang alternates, Open Graph URLs, sitemap.xml,
# robots.txt and the schema.org data. Must be the production domain in prod.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
