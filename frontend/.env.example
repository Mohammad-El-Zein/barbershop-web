# Frontend → backend. Copy to .env.local for `next dev` / `next build` (values are inlined at build time).
# Backend API (docker compose: http://localhost:8080)
NEXT_PUBLIC_API_URL=http://localhost:8080
# Tenant slug of this website (the demo shop)
NEXT_PUBLIC_TENANT=the-barber-news
# Public site origin (canonical / hreflang URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
