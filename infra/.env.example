# ─────────────────────────────────────────────────────────────────────────
# Copy to infra/.env and fill in. infra/.env is git-ignored — never commit it.
# Generate secrets e.g. with:  openssl rand -base64 48
# ─────────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────
POSTGRES_DB=barbershop
POSTGRES_USER=barbershop
POSTGRES_PASSWORD=change-me-strong-db-password
# The superuser above only creates the roles below (infra/postgres/init-roles.sql).
# Flyway migrates as the owner role; the backend's connection pool uses the DML-only
# application role (docs/DEPLOYMENT.md → Database roles).
DB_MIGRATION_USERNAME=barbershop_migrator
DB_MIGRATION_PASSWORD=change-me-migration-password
DB_APP_USERNAME=barbershop_app
DB_APP_PASSWORD=change-me-app-password
# host port for Postgres (use e.g. 5433 if a local PostgreSQL already uses 5432)
POSTGRES_HOST_PORT=5432

# ── Backend ─────────────────────────────────────────────────────────────
BACKEND_HOST_PORT=8080
# demo = also load the demo shop "The Barber News"; leave empty for a real client
SPRING_PROFILES_ACTIVE=demo
# HS256 signing key for admin tokens — at least 32 characters, random
APP_JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
# optional: separate key for email-link tokens (empty = derived from APP_JWT_SECRET)
APP_TOKEN_SECRET=
# refresh cookie only over HTTPS — set true in production (the prod profile defaults to true)
APP_COOKIE_SECURE=false
# scheduled jobs: expiry, reminders, auto-complete (every minute)
APP_JOBS_ENABLED=true
# payments: only "demo" exists (no real money). With SPRING_PROFILES_ACTIVE=prod the
# app refuses to start in demo mode unless PAYMENT_DEMO_ALLOW_IN_PROD=true.
PAYMENT_PROVIDER=demo
PAYMENT_DEMO_ALLOW_IN_PROD=false
# per-IP rate limits: bookings/min, logins/min, register+forgot-password per 10 min, email-link actions/min
APP_RATE_LIMIT_BOOKINGS=10
APP_RATE_LIMIT_LOGIN=5
APP_RATE_LIMIT_AUTH_MAIL=5
APP_RATE_LIMIT_TOKEN_ACTIONS=20
# first admin, created on startup if it doesn't exist (password ≥ 12 characters)
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=change-me-admin-password

# ── Frontend (CORS + links in emails) ───────────────────────────────────
# comma-separated list of allowed browser origins
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_FRONTEND_BASE_URL=http://localhost:3000

# ── Email ───────────────────────────────────────────────────────────────
# local default: Mailpit (UI on MAILPIT_UI_PORT). For production use your SMTP
# provider, e.g. Resend: SMTP_HOST=smtp.resend.com SMTP_PORT=587
#   SMTP_USERNAME=resend SMTP_PASSWORD=<api key> SMTP_AUTH=true SMTP_STARTTLS=true
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
APP_MAIL_FROM=The Barber News <no-reply@example.com>
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# ── hardening (see backend/README.md → Production hardening) ─────────────────
# Bot check on booking / register / forgot-password: none | turnstile.
# The prod profile refuses "none" unless APP_CAPTCHA_ALLOW_NONE_IN_PROD=true.
APP_CAPTCHA_PROVIDER=none
APP_CAPTCHA_SECRET=
APP_CAPTCHA_ALLOW_NONE_IN_PROD=false
# Rate-limit store: memory (ONE backend instance) | redis (several instances share the limits)
APP_RATE_LIMIT_STORE=memory
APP_RATE_LIMIT_REDIS_URL=
# Email outbox: attempts before a mail is marked DEAD (visible in the admin area)
APP_MAIL_MAX_ATTEMPTS=8
# Retention (keep in sync with the privacy policy): months / days; completed 0 = keep
APP_RETENTION_CANCELLED_MONTHS=6
APP_RETENTION_COMPLETED_MONTHS=0
APP_RETENTION_UNVERIFIED_DAYS=30
APP_RETENTION_OUTBOX_DAYS=30
# prod profile only: Swagger / OpenAPI stay off unless set to true; log format ecs | logstash | gelf
SPRINGDOC_API_DOCS_ENABLED=false
SPRINGDOC_SWAGGER_UI_ENABLED=false
LOG_FORMAT=ecs
