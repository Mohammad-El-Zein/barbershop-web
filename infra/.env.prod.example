# Production settings for infra/docker-compose.prod.example.yml (VPS).
# cp infra/.env.prod.example infra/.env.prod — NEVER commit the filled-in file.
# Generate secrets with: openssl rand -base64 48

# ── domains / HTTPS ───────────────────────────────────────────────────────────
SITE_DOMAIN=www.example-barber.de
API_DOMAIN=api.example-barber.de
ACME_EMAIL=it@example-barber.de
# shop slug (URL-safe, also NEXT_PUBLIC_TENANT of the frontend); on an empty database the shop
# is created on first start with this name / time zone — then fill it in the admin area
TENANT=the-barber-news
TENANT_NAME=The Barber News
TENANT_TIMEZONE=Europe/Berlin

# ── images (from CI; leave empty to build on the server with --build) ─────────
BACKEND_IMAGE=registry.example.com/barbershop/backend:1.0.0
FRONTEND_IMAGE=registry.example.com/barbershop/frontend:1.0.0

# ── database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=barbershop
POSTGRES_USER=barbershop
# superuser: creates the roles below on first start, backups — never used by the backend
POSTGRES_PASSWORD=
# owner role: only the one-off "migrate" service (Flyway) uses it
DB_MIGRATION_USERNAME=barbershop_migrator
DB_MIGRATION_PASSWORD=
# application role: DML only; the backend refuses to start in prod with a privileged login
DB_APP_USERNAME=barbershop_app
DB_APP_PASSWORD=

# ── backend secrets ───────────────────────────────────────────────────────────
# >= 32 random characters; the prod profile refuses weak or placeholder values
APP_JWT_SECRET=
APP_TOKEN_SECRET=
# first admin (created on first start if missing; remove the password afterwards)
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=

# ── email ─────────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
APP_MAIL_FROM=Barbershop <termine@example-barber.de>

# ── bot protection (Cloudflare Turnstile) ─────────────────────────────────────
APP_CAPTCHA_PROVIDER=turnstile
APP_CAPTCHA_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── site-wide DEMO strip (frontend build): false for a real shop, true for a public demo ─
NEXT_PUBLIC_SHOW_DEMO_BANNER=false

# ── rate limits: memory for one backend; redis for several (+ --profile redis) ─
APP_RATE_LIMIT_STORE=memory
APP_RATE_LIMIT_REDIS_URL=
REDIS_PASSWORD=

# ── payments: demo only. A REAL shop must not start with the demo provider. ───
# Public demo deployment: PAYMENT_DEMO_ALLOW_IN_PROD=true (shows the DEMO bar).
PAYMENT_PROVIDER=demo
PAYMENT_DEMO_ALLOW_IN_PROD=false

# ── analytics / ads (optional, loaded only after consent) ─────────────────────
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
NEXT_PUBLIC_META_PIXEL_ID=
